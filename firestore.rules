rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Solo usuarios autenticados (cuentas creadas en Firebase Authentication)
    // pueden leer o escribir. La app no permite auto-registro, así que el
    // acceso queda limitado a las cuentas que se creen manualmente.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}